<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice the network coming back and resume (PlaybackRecovery). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets Mero show the system's "run in the background?" dialog for
         itself, rather than sending people to a list to find it in. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Mero is not on Play, so it updates itself. Without this the system
         installer silently declines to open. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets the search bar's microphone check that a speech recogniser exists
         (Android 11+ hides other apps' activities unless asked for like this). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".MeroApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Mero"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mero">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mero.Splash"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- No LAUNCHER filter here: the home-screen entry is one of the
                 icon aliases below, so the icon can be changed from Settings. -->
            <!-- "Open with Mero" for an audio file in Files, WhatsApp, a
                 download notification. singleTask above so that lands in the
                 running app instead of stacking a second one with a second
                 player UI on top of the Files app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- content:// only. A file:// URI from another app would let it
                     point Mero at Mero's own private files — the database,
                     the Spotify secret — and have them read with Mero's
                     permissions. Android has refused to hand out file:// to
                     other apps since 7.0 anyway. -->
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- "Hey Google, play Kesariya on Mero" on the phone itself; in a
                 car the same request reaches the session instead. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- One launcher entry per app icon; exactly one is enabled at a time
             (AppIcon.kt). The names are stored by the system across updates,
             so renaming one strands whoever picked it on no icon at all. -->
        <activity-alias
            android:name=".IconClassic"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Mero"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMidnight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_midnight"
            android:roundIcon="@mipmap/ic_launcher_midnight"
            android:label="Mero"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPaper"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_paper"
            android:roundIcon="@mipmap/ic_launcher_paper"
            android:label="Mero"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCoral"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_coral"
            android:roundIcon="@mipmap/ic_launcher_coral"
            android:label="Mero"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOcean"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_ocean"
            android:label="Mero"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMint"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_mint"
            android:roundIcon="@mipmap/ic_launcher_mint"
            android:label="Mero"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".playback.MeroPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <!-- Library service, and the platform's older name for one: Android
                 Auto still looks for android.media.browse.MediaBrowserService. -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- Buttons on a headset or in a car reach a *running* session
                     through the service. This filter is what lets them reach a
                     session that is not running yet. -->
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Media3 does not declare this for you, and without it a play button
             pressed while Mero is not running is delivered to nobody: Android
             broadcasts ACTION_MEDIA_BUTTON, finds no receiver, and the press
             does nothing at all. It is also what puts Mero in the system's
             resumable-media row. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
