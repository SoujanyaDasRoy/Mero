<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice the network coming back and resume (PlaybackRecovery). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets Mero show the system's "run in the background?" dialog for
         itself, rather than sending people to a list to find it in. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Mero is not on Play, so it updates itself. Without this the system
         installer silently declines to open. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets the search bar's microphone check that a speech recogniser exists
         (Android 11+ hides other apps' activities unless asked for like this). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".MeroApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Mero"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mero">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mero.Splash"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- No LAUNCHER filter here: the home-screen entry is one of the
                 icon aliases below, so the icon can be changed from Settings. -->
            <!-- "Open with Mero" for an audio file in Files, WhatsApp, a
                 download notification. singleTask above so that lands in the
                 running app instead of stacking a second one with a second
                 player UI on top of the Files app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- content:// only. A file:// URI from another app would let it
                     point Mero at Mero's own private files — the database,
                     the Spotify secret — and have them read with Mero's
                     permissions. Android has refused to hand out file:// to
                     other apps since 7.0 anyway. -->
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- "Hey Google, play Kesariya on Mero" on the phone itself; in a
                 car the same request reaches the session instead. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- YouTube and YouTube Music links, so a song or playlist shared from
                 Mero (or anywhere) can open here. Not verified app links: Android
                 lists Mero beside YouTube and YouTube Music and the person picks
                 once ("Always"), or turns Mero on under Open by default in the
                 app's settings. Only watch, playlist and shorts addresses, never
                 the whole of youtube.com. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/shorts" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>
            <!-- A shared playlist file (.mero). Best effort: what an app hands over
                 depends on the app, so Settings > Library > Import a playlist file
                 is the way that always works. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-mero" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mero" />
            </intent-filter>
        </activity>

        <!-- Lets the share sheet read the playlist file Mero just wrote, and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- One launcher entry per app icon; exactly one is enabled at a time
             (AppIcon.kt). The names are stored by the system across updates,
             so renaming one strands whoever picked it on no icon at all. -->
        <activity-alias
            android:name=".IconClassic"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Mero"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Retired icons: the earlier recolours and the ten-icon set. Offered
             nowhere any more, but kept as launcher entries: someone who picked
             one has that alias enabled and Classic disabled, so deleting it
             would leave Mero without any launcher icon. They show the Mero logo,
             and AppIcon.applyPending moves anyone still on one to Classic the
             next time Mero is closed. Do not remove these. -->
        <activity-alias
            android:name=".IconMidnight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Mero"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
