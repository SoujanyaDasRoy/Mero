<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all real theming (ui/theme/Theme.kt). This exists only to
         drop the ActionBar and let the app draw edge to edge. -->
    <style name="Theme.Mero" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#141218</item>
    </style>

    <!-- Shown by the system before the first frame, so there is no white flash
         between the launcher and Mero's own animated splash. -->
    <style name="Theme.Mero.Splash" parent="Theme.SplashScreen">
        <!-- No animated icon: from Android 12 the system then draws the icon of
             the launcher entry that was tapped, so the splash follows the
             chosen app icon. -->
        <item name="windowSplashScreenBackground">#141218</item>
        <item name="postSplashScreenTheme">@style/Theme.Mero</item>
    </style>
</resources>
