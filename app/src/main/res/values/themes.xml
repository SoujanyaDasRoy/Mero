<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all real theming (ui/theme/Theme.kt). This exists only to
         drop the ActionBar and let the app draw edge to edge. -->
    <style name="Theme.Mero" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#141218</item>
    </style>
</resources>
